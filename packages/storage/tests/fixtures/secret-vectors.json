{
  "about": "Shared by agentdock-cli and AgentDock; keep both copies byte-identical. {secret} is replaced by prefix + body repeated, so no file holds a whole fake key.",
  "vectors": [
    {
      "name": "Anthropic key piped into set-key",
      "input": "echo {secret} | ctrlplane supervisor set-key claude --stdin",
      "secret": { "prefix": "sk-ant-api03-", "body": "Xy7_", "repeat": 12 },
      "expected": "echo [REDACTED_SECRET:ANTHROPIC_KEY] | ctrlplane supervisor set-key claude --stdin"
    },
    {
      "name": "Anthropic key in an environment line",
      "input": "ANTHROPIC_API_KEY={secret}",
      "secret": { "prefix": "sk-ant-api03-", "body": "Xy7_", "repeat": 12 },
      "expected": "ANTHROPIC_API_KEY=[REDACTED_SECRET:ANTHROPIC_KEY]"
    },
    {
      "name": "OpenAI project key in JSON",
      "input": "{\"apiKey\":\"{secret}\"}",
      "secret": { "prefix": "sk-proj-", "body": "Qw3e", "repeat": 10 },
      "expected": "{\"apiKey\":\"[REDACTED_SECRET:OPENAI_KEY]\"}"
    },
    {
      "name": "OpenAI key as a bearer token",
      "input": "curl -H \"Authorization: Bearer {secret}\" https://api.openai.com/v1/models",
      "secret": { "prefix": "sk-", "body": "Rt5y", "repeat": 9 },
      "expected": "curl -H \"Authorization: Bearer [REDACTED_SECRET:OPENAI_KEY]\" https://api.openai.com/v1/models"
    },
    {
      "name": "A key of unknown format is not recognised (callers must also remove the exact key)",
      "input": "printf %s {secret} | ctrlplane supervisor set-key openai-compatible --stdin",
      "secret": { "prefix": "planted-", "body": "9f3a", "repeat": 8 },
      "expected": "printf %s {secret} | ctrlplane supervisor set-key openai-compatible --stdin"
    },
    {
      "name": "Code that only looks like a token stays",
      "input": "task-scheduler-{secret} and await getToken(req)",
      "secret": { "prefix": "", "body": "abc", "repeat": 8 },
      "expected": "task-scheduler-{secret} and await getToken(req)"
    },
    {
      "name": "GitHub token as the whole userinfo of a git remote",
      "input": "git clone https://{secret}@github.com/o/r.git",
      "secret": { "prefix": "ghp_", "body": "Mn4b", "repeat": 9 },
      "expected": "git clone https://[REDACTED_SECRET:GITHUB_TOKEN]@github.com/o/r.git"
    },
    {
      "name": "GitHub token as the password of a git remote",
      "input": "git remote add origin https://x-access-token:{secret}@github.com/o/r.git",
      "secret": { "prefix": "ghp_", "body": "Mn4b", "repeat": 9 },
      "expected": "git remote add origin https://x-access-token:[REDACTED_SECRET:GITHUB_TOKEN]@github.com/o/r.git"
    },
    {
      "name": "GitLab token as the password of a git remote",
      "input": "https://oauth2:{secret}@gitlab.com/o/r.git",
      "secret": { "prefix": "glpat-", "body": "Pk8s", "repeat": 5 },
      "expected": "https://oauth2:[REDACTED_SECRET:GITLAB_TOKEN]@gitlab.com/o/r.git"
    }
  ]
}

{
  "name": "agentdock",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDock - AI Development Control Plane Engine and CLI Package",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 packages/*/tests/*.test.ts scripts/tests/*.test.ts",
    "ctrlplane": "node packages/cli/src/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene": "node scripts/hygiene.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
